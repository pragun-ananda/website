---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { readingTime } from '../utils/reading-time';
import { formatDate } from '../utils/date';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  math?: boolean;
  abstract?: string;
  ogImage?: string;
  headings: { depth: number; slug: string; text: string }[];
  body: string;
}

const { title, description, pubDate, updatedDate, tags, math, abstract, ogImage, headings, body } = Astro.props;
const time = readingTime(body);
---

<BaseLayout title={`${title} — Pragun`} description={description} image={ogImage} math={math}>
  <!-- Top Reading Progress Bar -->
  <div class="reading-progress-container">
    <div class="reading-progress-bar" id="reading-progress"></div>
  </div>

  <article class="post-container">
    <header class="post-header">
      <div class="back-link-wrapper">
        <a href="/blog" class="back-link">← Back to Writing</a>
      </div>
      
      <h1 class="post-title">{title}</h1>

      <div class="post-meta-line">
        <time datetime={pubDate.toISOString()} class="post-date">{formatDate(pubDate)}</time>
        <span class="meta-dot">·</span>
        <span class="post-reading-time">{time}</span>
        {tags.length > 0 && (
          <>
            <span class="meta-dot">·</span>
            <TagList tags={tags} />
          </>
        )}
      </div>

      {abstract && (
        <div class="post-abstract">
          <div class="abstract-label">💡 Summary</div>
          <p>{abstract}</p>
        </div>
      )}
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>
  </article>

  <script>
    async function initMermaid() {
      const mermaidNodes = document.querySelectorAll('pre > code.language-mermaid');
      if (!mermaidNodes.length) return;

      try {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          suppressErrorRendering: true,
        });

        for (let i = 0; i < mermaidNodes.length; i++) {
          const el = mermaidNodes[i];
          const pre = el.parentElement;
          if (!pre) continue;
          const code = el.textContent?.trim() ?? '';
          if (!code) continue;

          try {
            const id = `mermaid-graph-${Date.now()}-${i}`;
            const { svg } = await mermaid.render(id, code);
            const container = document.createElement('div');
            container.className = 'mermaid';
            container.innerHTML = svg;
            pre.replaceWith(container);
          } catch (renderError) {
            console.warn('Mermaid render error:', renderError);
            document.querySelectorAll('[id^="dmermaid-"], [id^="mermaid-"]').forEach((node) => {
              if (node.tagName === 'DIV' && !node.classList.contains('mermaid') && node.textContent?.includes('Syntax error')) {
                node.remove();
              }
            });
          }
        }
      } catch (err) {
        console.warn('Mermaid module load failed:', err);
      }
    }

    initMermaid();
    document.addEventListener('astro:after-swap', initMermaid);

    // Top reading progress bar calculation
    function initReadingProgress() {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;

      function updateProgress() {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) return;
        const progress = (window.scrollY / totalHeight) * 100;
        bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);
  </script>
</BaseLayout>

<style>
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    transition: width 0.1s ease-out;
  }

  .post-container {
    max-width: 760px;
    margin: 0 auto;
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .back-link-wrapper {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .post-meta-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-dot {
    color: var(--border);
  }

  .post-reading-time {
    color: var(--text);
    font-weight: 500;
  }

  .post-abstract {
    margin-top: 1.75rem;
    padding: 1.15rem 1.4rem;
    background: rgba(16, 185, 129, 0.05);
    border-left: 4px solid var(--accent);
    border-radius: 4px;
  }

  .abstract-label {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    margin-bottom: 0.4rem;
  }

  .post-abstract p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text);
    font-family: var(--font-serif);
  }
</style>

---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { readingTime } from '../utils/reading-time';
import { formatDate } from '../utils/date';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  math?: boolean;
  abstract?: string;
  ogImage?: string;
  headings: { depth: number; slug: string; text: string }[];
  body: string;
}

const { title, description, pubDate, updatedDate, tags, math, abstract, ogImage, headings, body } = Astro.props;
const time = readingTime(body);
---

<BaseLayout title={`${title} — Pragun`} description={description} image={ogImage} math={math}>
  <!-- Top Reading Progress Bar -->
  <div class="reading-progress-container">
    <div class="reading-progress-bar" id="reading-progress"></div>
  </div>

  <div class="post-layout-grid">
    <!-- Main Reading Column -->
    <article class="post-container">
      <header class="post-header">
        <div class="back-link-wrapper">
          <a href="/blog" class="back-link">← Back to Writing</a>
        </div>
        
        <h1 class="post-title">{title}</h1>

        <div class="post-meta-line">
          <time datetime={pubDate.toISOString()} class="post-date">{formatDate(pubDate)}</time>
          <span class="meta-dot">·</span>
          <span class="post-reading-time">{time}</span>
          {tags.length > 0 && (
            <>
              <span class="meta-dot">·</span>
              <TagList tags={tags} />
            </>
          )}
        </div>

        {abstract && (
          <div class="post-abstract">
            <div class="abstract-label">💡 Summary</div>
            <p>{abstract}</p>
          </div>
        )}
      </header>

      <!-- Inline TOC for mobile / tablet (< 1080px) -->
      <div class="toc-inline-wrapper">
        <TableOfContents headings={headings} mode="inline" />
      </div>

      <div class="prose">
        <slot />
      </div>
    </article>

    <!-- Sticky Sidebar for Wide Displays (>= 1080px) -->
    {headings.length > 0 && (
      <aside class="post-sidebar">
        <div class="sidebar-sticky">
          <TableOfContents headings={headings} mode="sidebar" />
        </div>
      </aside>
    )}
  </div>

  <script>
    async function initMermaid() {
      const mermaidNodes = document.querySelectorAll('pre > code.language-mermaid');
      if (!mermaidNodes.length) return;

      try {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          suppressErrorRendering: true,
        });

        for (let i = 0; i < mermaidNodes.length; i++) {
          const el = mermaidNodes[i];
          const pre = el.parentElement;
          if (!pre) continue;
          const code = el.textContent?.trim() ?? '';
          if (!code) continue;

          try {
            const id = `mermaid-graph-${Date.now()}-${i}`;
            const { svg } = await mermaid.render(id, code);
            const container = document.createElement('div');
            container.className = 'mermaid';
            container.innerHTML = svg;
            pre.replaceWith(container);
          } catch (renderError) {
            console.warn('Mermaid render error:', renderError);
            document.querySelectorAll('[id^="dmermaid-"], [id^="mermaid-"]').forEach((node) => {
              if (node.tagName === 'DIV' && !node.classList.contains('mermaid') && node.textContent?.includes('Syntax error')) {
                node.remove();
              }
            });
          }
        }
      } catch (err) {
        console.warn('Mermaid module load failed:', err);
      }
    }

    initMermaid();
    document.addEventListener('astro:after-swap', initMermaid);

    // Top reading progress bar calculation
    function initReadingProgress() {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;

      function updateProgress() {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) return;
        const progress = (window.scrollY / totalHeight) * 100;
        bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);
  </script>
</BaseLayout>

<style>
  .reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    transition: width 0.1s ease-out;
  }

  /* Responsive Grid Layout */
  .post-layout-grid {
    display: block;
    width: 100%;
  }

  @media (min-width: 1080px) {
    .post-layout-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .post-container {
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 1080px) {
    .post-container {
      margin: 0;
    }
  }

  .back-link-wrapper {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .post-meta-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-dot {
    color: var(--border);
  }

  .post-reading-time {
    color: var(--accent);
  }

  /* Abstract / Summary Callout */
  .post-abstract {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: rgba(16, 185, 129, 0.05);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text);
  }

  .abstract-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  /* Mobile Inline TOC vs Desktop Sticky Sidebar */
  .toc-inline-wrapper {
    display: block;
  }

  .post-sidebar {
    display: none;
  }

  @media (min-width: 1080px) {
    .toc-inline-wrapper {
      display: none;
    }

    .post-sidebar {
      display: block;
      padding-top: 5rem;
    }

    .sidebar-sticky {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }
  }
</style>

---
interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<span class="tag-list">
  {tags.map((tag) =>
    linked ? (
      <a href={`/tags/${tag}`} class="tag">{tag}</a>
    ) : (
      <span class="tag">{tag}</span>
    )
  )}
</span>

<style>
  .tag-list {
    display: inline-flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--tag-text);
    background: var(--tag-bg);
    text-decoration: none;
    padding: 0.15em 0.55em;
    border-radius: 4px;
    letter-spacing: 0.01em;
    border: 1px solid var(--border);
  }

  a.tag:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>

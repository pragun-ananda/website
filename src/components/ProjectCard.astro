---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  repo?: string;
  tags: string[];
  status: 'active' | 'archived' | 'wip';
}

const { title, description, url, repo, tags, status } = Astro.props;

const statusLabel: Record<string, string> = {
  active: 'ACTIVE',
  archived: 'ARCHIVED',
  wip: 'WIP',
};
---

<article class="project-card tech-box">
  <div class="project-header">
    <h3 class="project-title">
      {url ? <a href={url} target="_blank" rel="noopener noreferrer">{title}</a> : title}
    </h3>
    <span class:list={['status', status]}>{statusLabel[status]}</span>
  </div>
  <p class="project-description">{description}</p>
  <div class="project-footer">
    {tags.length > 0 && <TagList tags={tags} linked={false} />}
    {repo && (
      <a href={repo} target="_blank" rel="noopener noreferrer" class="repo-link">
        [ SOURCE_CODE ↗ ]
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    padding: 1.5rem 1.75rem;
    border-radius: 0px; /* Flat edges */
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .project-title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2em 0.6em;
    border-radius: 0px;
    white-space: nowrap;
    letter-spacing: 0.05em;
    border: 1px solid transparent;
  }

  .status.active {
    color: var(--accent);
    background: var(--tag-bg);
    border-color: var(--tag-border);
  }

  .status.wip {
    color: var(--accent-secondary);
    background: rgba(132, 204, 22, 0.06);
    border-color: rgba(132, 204, 22, 0.2);
  }

  .status.archived {
    color: var(--muted);
    background: var(--code-bg);
    border-color: var(--border);
  }

  .project-description {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.6;
    font-family: var(--font-sans);
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .repo-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .repo-link:hover {
    color: var(--accent);
  }
</style>

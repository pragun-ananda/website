---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  repo?: string;
  tags: string[];
  status: 'active' | 'archived' | 'wip';
}

const { title, description, url, repo, tags, status } = Astro.props;

const statusLabel: Record<string, string> = {
  active: 'Active',
  archived: 'Archived',
  wip: 'In progress',
};
---

<article class="project-card">
  <div class="project-header">
    <h3 class="project-title">
      {url ? <a href={url} target="_blank" rel="noopener noreferrer">{title}</a> : title}
    </h3>
    <span class:list={['status', status]}>{statusLabel[status]}</span>
  </div>
  <p class="project-description">{description}</p>
  <div class="project-footer">
    {tags.length > 0 && <TagList tags={tags} linked={false} />}
    {repo && (
      <a href={repo} target="_blank" rel="noopener noreferrer" class="repo-link">
        Source ↗
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .project-card:hover {
    border-color: var(--muted);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
  }

  .project-title a:hover {
    color: var(--accent);
  }

  .status {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.15em 0.55em;
    border-radius: 4px;
    white-space: nowrap;
  }

  .status.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .status.wip {
    color: var(--accent-secondary);
    background: color-mix(in srgb, var(--accent-secondary) 12%, transparent);
  }

  .status.archived {
    color: var(--muted);
    background: var(--border);
  }

  .project-description {
    color: var(--muted);
    font-size: 0.875rem;
    margin-bottom: 0.875rem;
    line-height: 1.6;
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .repo-link {
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
  }

  .repo-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>

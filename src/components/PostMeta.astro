---
import { formatDate } from '../utils/date';
import TagList from './TagList.astro';

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  tags: string[];
}

const { pubDate, updatedDate, readingTime, tags } = Astro.props;
---

<div class="post-meta">
  <span>&gt; date: {formatDate(pubDate)}</span>
  {updatedDate && <span>&gt; updated: {formatDate(updatedDate)}</span>}
  <span>&gt; read: {readingTime}</span>
  {tags.length > 0 && (
    <span class="meta-tags">&gt; tags: <TagList tags={tags} /></span>
  )}
</div>

<style>
  .post-meta {
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
</style>

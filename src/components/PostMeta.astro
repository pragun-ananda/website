---
import { formatDate } from '../utils/date';
import TagList from './TagList.astro';

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  tags: string[];
}

const { pubDate, updatedDate, readingTime, tags } = Astro.props;
---

<div class="post-meta">
  <span class="meta-item">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </span>
  <span class="meta-sep">·</span>
  <span class="meta-item">{readingTime}</span>
  {updatedDate && (
    <>
      <span class="meta-sep">·</span>
      <span class="meta-item">Updated {formatDate(updatedDate)}</span>
    </>
  )}
  {tags.length > 0 && (
    <>
      <span class="meta-sep">·</span>
      <span class="meta-item"><TagList tags={tags} /></span>
    </>
  )}
</div>

<style>
  .post-meta {
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.75rem 0 2rem;
  }

  .meta-sep {
    color: var(--border);
  }
</style>

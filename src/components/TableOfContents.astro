---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <div class="toc-container tech-box">
    <div class="toc-header">
      <span class="toc-title">INDEX // SECTIONS</span>
    </div>
    <nav class="toc-nav">
      <ul class="toc-list">
        {filtered.map((heading) => (
          <li class:list={['toc-item', heading.depth === 3 ? 'indent' : '']}>
            <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug}>
              <span class="toc-bullet">›</span> {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .toc-container {
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
    background: var(--surface);
  }

  .toc-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .toc-title {
    color: var(--muted);
    font-weight: 700;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item.indent {
    padding-left: 0.85rem;
  }

  .toc-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    line-height: 1.4;
    display: block;
    transition: color 0.15s, transform 0.15s;
  }

  .toc-bullet {
    color: var(--accent);
    opacity: 0.6;
    margin-right: 0.25rem;
  }

  .toc-link:hover {
    color: var(--text);
    text-decoration: none;
    transform: translateX(2px);
  }

  .toc-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  .toc-link.active .toc-bullet {
    opacity: 1;
  }
</style>

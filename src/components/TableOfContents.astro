---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <details class="toc" open>
    <summary class="toc-title">Table of contents</summary>
    <nav class="toc-nav">
      <ul>
        {filtered.map((heading) => (
          <li class={heading.depth === 3 ? 'indent' : ''}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<style>
  .toc {
    margin: 1.5rem 0;
    padding: 0.875rem 1.125rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .toc-title {
    cursor: pointer;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    user-select: none;
    list-style: none;
  }

  .toc-title::-webkit-details-marker {
    display: none;
  }

  .toc-title::before {
    content: '▸ ';
    font-size: 0.625rem;
    vertical-align: middle;
  }

  details[open] .toc-title::before {
    content: '▾ ';
  }

  .toc-title:hover {
    color: var(--text);
  }

  .toc-nav {
    margin-top: 0.625rem;
  }

  .toc-nav ul {
    list-style: none;
    padding: 0;
  }

  .toc-nav li {
    margin: 0.2rem 0;
  }

  .toc-nav li.indent {
    padding-left: 1.125rem;
  }

  .toc-nav a {
    color: var(--muted);
    text-decoration: none;
    line-height: 1.5;
  }

  .toc-nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>

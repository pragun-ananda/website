---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <details class="toc-outline" open>
    <summary class="toc-summary">
      <span class="toc-title">Table of Contents</span>
    </summary>
    <nav class="toc-nav">
      <ol class="toc-list">
        {filtered.map((heading) => (
          <li class:list={['toc-item', heading.depth === 3 ? 'indent' : '']}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .toc-outline {
    margin: 2rem 0;
    padding: 0.9rem 1.25rem;
    background: rgba(16, 185, 129, 0.04);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .toc-summary {
    cursor: pointer;
    color: var(--text);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-summary::before {
    content: "▸";
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .toc-outline[open] .toc-summary::before {
    transform: rotate(90deg);
  }

  .toc-nav {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border);
  }

  .toc-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-item.indent {
    padding-left: 1rem;
    list-style-type: circle;
  }

  .toc-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.825rem;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

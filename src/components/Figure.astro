---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem 0;
    text-align: center;
  }

  .figure img {
    border-radius: 4px;
    border: 1px solid var(--border);
    max-width: 100%;
  }

  figcaption {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 0.5rem;
    font-style: italic;
  }
</style>

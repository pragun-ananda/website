---
import { formatDate } from '../utils/date';
import { readingTime } from '../utils/reading-time';

interface Post {
  id: string;
  body?: string;
  data: {
    title: string;
    pubDate: Date;
    tags: string[];
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <time datetime={post.data.pubDate.toISOString()} class="post-date">
        {formatDate(post.data.pubDate)}
      </time>
      <div class="post-main">
        <a href={`/blog/${post.id}`} class="post-title-link">
          {post.data.title}
        </a>
        {post.body && (
          <span class="read-badge">{readingTime(post.body)}</span>
        )}
      </div>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    flex-direction: column;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
    gap: 0.4rem;
  }

  @media (min-width: 600px) {
    .post-row {
      flex-direction: row;
      align-items: baseline;
      gap: 2rem;
    }
  }

  .post-date {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    flex-shrink: 0;
    min-width: 7.5rem;
  }

  .post-main {
    flex: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-title-link {
    font-family: var(--font-serif);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    transition: color 0.15s ease;
  }

  .post-title-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .read-badge {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid var(--tag-border);
    padding: 0.12em 0.55em;
    border-radius: 4px;
    white-space: nowrap;
  }
</style>

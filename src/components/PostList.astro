---
import { formatDate } from '../utils/date';

interface Post {
  id: string;
  data: {
    title: string;
    pubDate: Date;
    tags: string[];
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a href={`/blog/${post.id}`}>{post.data.title}</a>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1rem;
    line-height: 1.5;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row time {
    color: var(--muted);
    font-size: 0.8125rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    min-width: 7rem;
  }

  .post-row a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .post-row a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>

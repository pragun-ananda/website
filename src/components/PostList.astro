---
import { formatDate } from '../utils/date';

interface Post {
  id: string;
  data: {
    title: string;
    pubDate: Date;
    tags: string[];
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a href={`/blog/${post.id}`} class="post-title-link">{post.data.title}</a>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0.5rem 0;
    position: relative;
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
    margin-left: 0.5rem;
  }

  /* Fade out timeline ends */
  .post-list::before {
    content: "";
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 1.5rem;
    background: linear-gradient(to top, var(--bg), transparent);
  }

  .post-list::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: -1px;
    width: 1px;
    height: 1.5rem;
    background: linear-gradient(to bottom, var(--bg), transparent);
  }

  .post-row {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.75rem 0;
    transition: all 0.2s ease;
  }

  @media (min-width: 480px) {
    .post-row {
      flex-direction: row;
      align-items: baseline;
      gap: 1.5rem;
    }
  }

  /* Monospace square bullets on the line */
  .post-row::before {
    content: "";
    position: absolute;
    left: -1.5rem; /* Align to the border left */
    top: 1.25rem;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background-color: var(--muted);
    border: 2px solid var(--bg);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 480px) {
    .post-row::before {
      top: 1.2rem;
    }
  }

  .post-row:hover::before {
    background-color: var(--accent);
    transform: translate(-50%, -50%) scale(1.3);
  }

  .post-row time {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    min-width: 7rem;
  }

  .post-title-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .post-row:hover .post-title-link {
    color: var(--accent);
  }
</style>

---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
---

<header class="header">
  <nav class="nav">
    <a href="/" class="nav-home">Pragun Ananda</a>
    <div class="nav-links">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { active: pathname.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.125rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-home {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-home:hover {
    color: var(--text);
    text-decoration: none;
    opacity: 0.75;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 400;
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    text-decoration: none;
  }
</style>

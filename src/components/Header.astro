---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/blog', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
---

<header class="header">
  <nav class="nav">
    <a href="/" class="nav-home">
      <span class="logo-text">Pragun Ananda</span>
    </a>
    <div class="nav-links">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { active: pathname.startsWith(href) }]}
        >
          <span class="nav-bracket">[</span>
          <span class="nav-label">{label}</span>
          <span class="nav-bracket">]</span>
        </a>
      ))}
      <div class="nav-divider"></div>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .nav {
      padding: 1.2rem 2rem;
    }
  }

  .nav-home {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-home:hover {
    color: var(--text);
    text-decoration: none;
    opacity: 0.85;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .nav-links {
      gap: 1.25rem;
    }
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .nav-bracket {
    opacity: 0;
    color: var(--accent);
    transition: opacity 0.2s, transform 0.2s;
    font-weight: 700;
  }

  .nav-link:hover .nav-bracket,
  .nav-link.active .nav-bracket {
    opacity: 0.6;
  }

  .nav-link:hover .nav-bracket:first-child {
    transform: translateX(-2px);
  }

  .nav-link:hover .nav-bracket:last-child {
    transform: translateX(2px);
  }

  .nav-link.active .nav-bracket {
    opacity: 1;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    text-decoration: none;
  }

  .nav-label {
    padding: 0 0.15rem;
  }

  .nav-divider {
    width: 1px;
    height: 14px;
    background-color: var(--border);
  }
</style>

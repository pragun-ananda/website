---
import { formatDate } from '../utils/date';
import TagList from './TagList.astro';
import { readingTime as calcReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  body?: string;
  readingTime?: string;
}

const { title, description, pubDate, tags, slug, body, readingTime } = Astro.props;
const displayTime = readingTime ?? (body ? calcReadingTime(body) : null);
---

<article class="post-card-container" data-tags={JSON.stringify(tags.map(t => t.toLowerCase()))}>
  <!-- Timeline bullet mapping to the left border -->
  <div class="timeline-bullet"></div>
  
  <div class="post-card tech-box">
    <div class="post-meta-row">
      <div class="post-date-group">
        <time datetime={pubDate.toISOString()} class="post-date">{formatDate(pubDate)}</time>
        {displayTime && <span class="read-badge">{displayTime.toUpperCase()}</span>}
      </div>
      {tags.length > 0 && <TagList tags={tags} />}
    </div>
    
    <a href={`/blog/${slug}`} class="post-link">
      <h3 class="post-title">{title}</h3>
    </a>
    
    <p class="post-description">{description}</p>
  </div>
</article>

<style>
  .post-card-container {
    position: relative;
    padding-left: 0.25rem;
    margin-bottom: 1.5rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .post-card-container.hidden {
    display: none;
  }

  .timeline-bullet {
    position: absolute;
    left: -1.5rem;
    top: 2.2rem;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background-color: var(--muted);
    border: 2px solid var(--bg);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card-container:hover .timeline-bullet {
    background-color: var(--accent);
    transform: translate(-50%, -50%) scale(1.3);
  }

  .post-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .post-date-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .read-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid var(--tag-border);
    padding: 0.15em 0.55em;
    letter-spacing: 0.05em;
  }

  .post-link {
    text-decoration: none;
    display: block;
    width: fit-content;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .post-link:hover .post-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .post-description {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
  }
</style>

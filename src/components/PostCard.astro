---
import { formatDate } from '../utils/date';
import TagList from './TagList.astro';
import { readingTime as calcReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  body?: string;
  readingTime?: string;
}

const { title, description, pubDate, tags, slug, body, readingTime } = Astro.props;
const displayTime = readingTime ?? (body ? calcReadingTime(body) : null);
---

<article class="post-card-container" data-tags={JSON.stringify(tags.map(t => t.toLowerCase()))}>
  <div class="post-row">
    <div class="post-meta-col">
      <time datetime={pubDate.toISOString()} class="post-date">{formatDate(pubDate)}</time>
      {displayTime && <span class="read-badge">{displayTime}</span>}
    </div>
    
    <div class="post-content-col">
      <a href={`/blog/${slug}`} class="post-link">
        <h3 class="post-title">{title}</h3>
      </a>
      <p class="post-description">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags-row">
          <TagList tags={tags} />
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .post-card-container {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.2s ease;
  }

  .post-card-container.hidden {
    display: none;
  }

  .post-row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  @media (min-width: 640px) {
    .post-row {
      flex-direction: row;
      align-items: baseline;
      gap: 2.5rem;
    }
  }

  .post-meta-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    min-width: 8.5rem;
  }

  @media (min-width: 640px) {
    .post-meta-col {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }

  .post-date {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .read-badge {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--accent);
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid var(--tag-border);
    padding: 0.1em 0.5em;
    border-radius: 4px;
    white-space: nowrap;
  }

  .post-content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-link {
    text-decoration: none;
    width: fit-content;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .post-link:hover .post-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
    font-family: var(--font-serif);
    margin: 0;
  }

  .post-tags-row {
    margin-top: 0.35rem;
  }
</style>

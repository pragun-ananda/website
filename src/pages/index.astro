---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../utils/posts';

const posts = await getSortedPosts();
---

<BaseLayout title="Pragun Ananda" description="ML software engineer writing about AI systems, infrastructure, and machine learning.">
  <section class="hero animate-fade-in">
    <div class="hero-container">
      <div class="hero-details">
        <div class="hero-header">
          <h1 class="name">Pragun Ananda</h1>
          <p class="role">ML Software Engineer · Systems & Infrastructure</p>
        </div>
        <p class="bio">
          I build machine learning systems and infrastructure. I write about ML engineering,
          distributed computing, and the practical craft of shipping AI in production.
        </p>
        <div class="social-links">
          <a href="https://github.com/pragun-ananda" target="_blank" rel="noopener noreferrer" class="social-link">GitHub ↗</a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-link">Twitter ↗</a>
          <a href="mailto:pragun@example.com" class="social-link">Email ↗</a>
        </div>
      </div>
      <div class="hero-avatar">
        <div class="avatar-box">
          <img 
            src="/avatar.jpg" 
            onerror="this.onerror=null; this.src='/avatar.png';" 
            alt="Pragun Ananda" 
            class="avatar-image" 
          />
        </div>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="section-header">
      <h2 class="section-heading">Writing</h2>
      <a href="/blog" class="all-link">View all →</a>
    </div>
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">No posts published yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-container {
    display: flex;
    flex-direction: column-reverse;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .hero-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
    }
  }

  .hero-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text);
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
  }

  .bio {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 540px;
    font-family: var(--font-sans);
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.25rem;
  }

  .social-link {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .social-link:hover {
    color: var(--accent);
  }

  .hero-avatar {
    flex-shrink: 0;
    align-self: center;
  }

  @media (min-width: 640px) {
    .hero-avatar {
      align-self: auto;
    }
  }

  .avatar-box {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.1);
  }

  @media (min-width: 640px) {
    .avatar-box {
      width: 135px;
      height: 135px;
    }
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .avatar-box:hover .avatar-image {
    filter: grayscale(0%);
  }

  .posts-section {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .all-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .all-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 2rem;
  }

  .animate-fade-in {
    animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../utils/posts';

const posts = await getSortedPosts();
---

<BaseLayout title="Pragun Ananda" description="ML software engineer writing about AI systems, infrastructure, and machine learning.">
  <section class="hero">
    <h1 class="name">Pragun Ananda</h1>
    <p class="role">ML Software Engineer</p>
    <p class="bio">
      I build machine learning systems and infrastructure. I write about ML engineering,
      model internals, and the practical craft of shipping AI in production.
    </p>
  </section>

  <section class="posts-section">
    <h2 class="section-heading">Writing</h2>
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">No posts yet. Check back soon.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .name {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.375rem;
    color: var(--text);
  }

  .role {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .bio {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 540px;
  }

  .posts-section {
    padding-bottom: 2rem;
  }

  .section-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .empty {
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>

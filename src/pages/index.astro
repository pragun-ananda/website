---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../utils/posts';

const posts = await getSortedPosts();
---

<BaseLayout title="Pragun Ananda" description="ML software engineer writing about AI systems, infrastructure, and machine learning.">
  <section class="hero animate-fade-in">
    <div class="hero-container">
      <div class="hero-details">
        <div class="hero-header">
          <h1 class="name">Pragun Ananda</h1>
          <p class="role">ML Software Engineer // Systems & Infrastructure</p>
        </div>
        <p class="bio">
          I build machine learning systems and infrastructure. I write about ML engineering,
          model internals, and the practical craft of shipping AI in production.
        </p>
      </div>
      <div class="hero-avatar">
        <div class="avatar-box tech-box">
          <img 
            src="/avatar.jpg" 
            onerror="this.onerror=null; this.src='/avatar.png';" 
            alt="Pragun Ananda" 
            class="avatar-image" 
          />
        </div>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <h2 class="section-heading">[01] Selected_Writing</h2>
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">No posts found in database.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 0 3rem;
  }

  .hero-container {
    display: flex;
    flex-direction: column-reverse;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .hero-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
    }
  }

  .hero-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text);
    /* Subtle text gradient for premium feel */
    background: linear-gradient(135deg, var(--text) 50%, color-mix(in srgb, var(--text) 70%, var(--accent)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .bio {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.8;
    max-width: 580px;
  }

  .hero-avatar {
    flex-shrink: 0;
    align-self: center;
  }

  @media (min-width: 640px) {
    .hero-avatar {
      align-self: auto;
    }
  }

  .avatar-box {
    width: 130px;
    height: 130px;
    border-radius: 0px; /* Flat edges matching timeline cards */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .avatar-box {
      width: 145px;
      height: 145px;
    }
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(105%);
    transition: filter 0.3s ease;
  }

  .avatar-box:hover .avatar-image {
    filter: grayscale(0%) contrast(100%);
  }

  .posts-section {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  .section-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    display: flex;
    align-items: center;
  }

  .section-heading::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
    margin-left: 1rem;
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 2rem;
    border: 1px dashed var(--border);
    border-radius: 8px;
    text-align: center;
  }

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

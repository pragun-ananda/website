---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../utils/posts';

const posts = await getSortedPosts();
---

<BaseLayout title="Pragun" description="Research blog on AI, infrastructure, and systems.">
  <section class="hero">
    <h1 class="name">Pragun Ananda</h1>
    <p class="role">Senior Staff Research Engineer · AI Systems</p>
    <p class="bio">
      I write about machine learning research, inference infrastructure, and the engineering
      behind large-scale AI systems.
    </p>
  </section>

  <hr />

  <section class="recent">
    <h2 class="section-title">Writing</h2>
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">No posts yet. Check back soon.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 0 1.5rem;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--text);
  }

  .role {
    font-size: 0.875rem;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .bio {
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 520px;
    line-height: 1.65;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .empty {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';

const tags = await getAllTags();
const sortedTags = [...tags.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="tags — pragun" description="All tags.">
  <h1 class="page-title">## tags</h1>

  {sortedTags.length > 0 ? (
    <div class="tag-grid">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}`} class="tag-item">
          [{tag}] <span class="count">({count})</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">No tags yet.</p>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-item {
    color: var(--accent-secondary);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .tag-item:hover {
    color: var(--text);
  }

  .count {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .empty {
    color: var(--muted);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout title="Projects — Pragun" description="Things I've built and am working on.">
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="subtitle">Open-source tools, machine learning libraries, and systems engineering experiments.</p>
  </div>

  {projects.length > 0 ? (
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          url={project.data.url}
          repo={project.data.repo}
          tags={project.data.tags}
          status={project.data.status}
        />
      ))}
    </div>
  ) : (
    <p class="empty">Coming soon.</p>
  )}
</BaseLayout>

<style>
  .page-header {
    padding: 2.5rem 0 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.65;
    font-family: var(--font-serif);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    padding: 2rem;
  }
</style>

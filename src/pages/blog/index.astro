---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, getAllTags } from '../../utils/posts';

const posts = await getSortedPosts();
const tagsMap = await getAllTags();
const allTags = Array.from(tagsMap.keys()).sort();
---

<BaseLayout title="Writing — Pragun" description="Technical writing and research notes on ML systems, inference architecture, and AI engineering.">
  <div class="page-header">
    <h1 class="page-title">Writing</h1>
    <p class="subtitle">Deep dives into ML systems, distributed training, and AI infrastructure.</p>
    
    <!-- Topic Filter Pills -->
    <div class="filter-container">
      <div class="filter-pills" id="filter-pills">
        <button class="filter-pill active" data-filter="all">All ({posts.length})</button>
        {allTags.map((tag) => (
          <button class="filter-pill" data-filter={tag.toLowerCase()}>
            {tag} ({tagsMap.get(tag)})
          </button>
        ))}
      </div>
    </div>
  </div>

  {posts.length > 0 ? (
    <div class="posts-list" id="posts-container">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          body={post.body}
        />
      ))}
    </div>
  ) : (
    <p class="empty">No posts found.</p>
  )}
</BaseLayout>

<style>
  .page-header {
    padding: 2.5rem 0 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-family: var(--font-sans);
  }

  .filter-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
  }

  .filter-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2em 0.65em;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    color: var(--text);
    border-color: var(--border-hover);
  }

  .filter-pill.active {
    background: rgba(16, 185, 129, 0.08);
    color: var(--accent);
    border-color: var(--accent);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .empty {
    color: var(--muted);
    padding-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
</style>

<script>
  function setupFiltering() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.post-card-container');
    if (!pills.length || !cards.length) return;

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-filter') ?? 'all';
        
        // Update active state
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        // Filter cards
        cards.forEach((card) => {
          if (filter === 'all') {
            card.classList.remove('hidden');
          } else {
            const cardTags: string[] = JSON.parse(card.getAttribute('data-tags') ?? '[]');
            if (cardTags.includes(filter)) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });
      });
    });
  }

  setupFiltering();
  document.addEventListener('astro:after-swap', setupFiltering);
</script>
